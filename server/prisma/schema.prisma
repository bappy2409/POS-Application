generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Branch {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  name      String   @db.NVarChar(150)
  code      String   @unique @db.NVarChar(32)
  address   String?  @db.NVarChar(500)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  inventory Inventory[]
  orders    Order[]

  @@map("branches")
}

model User {
  id           String   @id @default(uuid()) @db.UniqueIdentifier
  email        String   @unique @db.NVarChar(320)
  firstName    String   @db.NVarChar(100)
  lastName     String   @db.NVarChar(100)
  passwordHash String   @db.NVarChar(255)
  /// Constrained to valid roles in the SQL Server migration.
  role         String   @default("cashier") @db.NVarChar(32)
  branchId     String?  @db.UniqueIdentifier
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch               Branch?               @relation(fields: [branchId], references: [id], onDelete: NoAction)
  inventoryAdjustments InventoryAdjustment[]

  @@index([branchId])
  @@map("users")
}

model Product {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  name           String   @db.NVarChar(200)
  description    String?  @db.NVarChar(Max)
  basePriceCents Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  variants ProductVariant[]

  @@index([isActive])
  @@map("products")
}

model ProductVariant {
  id                 String   @id @default(uuid()) @db.UniqueIdentifier
  productId          String   @db.UniqueIdentifier
  size               String?  @db.NVarChar(50)
  color              String?  @db.NVarChar(50)
  sku                String   @unique @db.NVarChar(100)
  priceOverrideCents Int?
  lowStockThreshold  Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: NoAction)
  inventory  Inventory[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Inventory {
  id               String   @id @default(uuid()) @db.UniqueIdentifier
  productVariantId String   @db.UniqueIdentifier
  branchId         String?  @db.UniqueIdentifier
  quantity         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  productVariant ProductVariant        @relation(fields: [productVariantId], references: [id], onDelete: NoAction)
  branch         Branch?               @relation(fields: [branchId], references: [id], onDelete: NoAction)
  adjustments    InventoryAdjustment[]

  @@unique([productVariantId, branchId])
  @@index([branchId])
  @@map("inventory")
}

model InventoryAdjustment {
  id               String   @id @default(uuid()) @db.UniqueIdentifier
  inventoryId      String   @db.UniqueIdentifier
  adjustedByUserId String   @db.UniqueIdentifier
  quantityDelta    Int
  reason           String   @db.NVarChar(500)
  createdAt        DateTime @default(now())

  inventory      Inventory @relation(fields: [inventoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  adjustedByUser User      @relation(fields: [adjustedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([inventoryId, createdAt])
  @@index([adjustedByUserId])
  @@map("inventory_adjustments")
}

model Order {
  id         String   @id @default(uuid()) @db.UniqueIdentifier
  /// Constrained to `pos` and `online` in the SQL Server migration.
  channel    String   @default("pos") @db.NVarChar(16)
  branchId   String?  @db.UniqueIdentifier
  /// Constrained to valid order states in the SQL Server migration.
  status     String   @default("pending") @db.NVarChar(32)
  totalCents Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  branch   Branch?     @relation(fields: [branchId], references: [id], onDelete: NoAction)
  items    OrderItem[]
  payments Payment[]

  @@index([branchId, createdAt])
  @@index([channel, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id               String   @id @default(uuid()) @db.UniqueIdentifier
  orderId          String   @db.UniqueIdentifier
  variantId        String   @db.UniqueIdentifier
  qty              Int
  priceAtSaleCents Int
  createdAt        DateTime @default(now())

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: NoAction)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model Payment {
  id          String   @id @default(uuid()) @db.UniqueIdentifier
  orderId     String   @db.UniqueIdentifier
  /// Constrained to valid payment methods in the SQL Server migration.
  method      String   @db.NVarChar(32)
  amountCents Int
  /// Constrained to valid payment states in the SQL Server migration.
  status      String   @default("pending") @db.NVarChar(32)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("payments")
}
